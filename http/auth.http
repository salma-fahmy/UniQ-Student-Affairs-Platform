# global variables
@baseUrl = http://localhost:3000
@token =  PASTE_YOUR_JWT_TOKEN_HERE




# check the server is working
Get {{baseUrl}}/health
Authorization: Bearer {{token}}

#### get All users test 
Get {{baseUrl}}/users
Authorization: Bearer {{token}}


##################################################

##auth routes . 
#### login as student
Post {{baseUrl}}/api/v1/auth/login 
Content-Type: application/json

//osama student id in the database, if you want to test with your CDS account search on DB for userId
{
  "userId": "<script>alert(\"heelo\")</script>",
  "password": "123456789"
}



#######
Post {{baseUrl}}/api/v1/auth/login 
Content-Type: application/json

//osama student id in the database, if you want to test with your CDS account search on DB for userId
{
  "userId":"22010007",
  "password": "12345678"
}

