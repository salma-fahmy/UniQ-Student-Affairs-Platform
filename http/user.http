###############################################################################
# ADMIN — User Management
# All routes below require admin role + read:user / update:user permission
###############################################################################

###
# paste the admin token here
@adminToken = PASTE_ADMIN_JWT_TOKEN_HERE
# admin login (if not already logged in)
Post {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
    "userId": "super-admin-1975-031",
    "password": "12345678"
}




###############################################################################
# 1. List All Users  (paginated)
#    Optional query params:
#      ?page=1&limit=20
#      ?role=student | academic_staff | affairs_staff | admin
###############################################################################
GET {{baseUrl}}/api/v1/users/admin/all?page=1&limit=20
Authorization: Bearer {{adminToken}}

###
# filter by role
GET {{baseUrl}}/api/v1/users/admin/all?page=1&limit=20&role=student
Authorization: Bearer {{adminToken}}

###
GET {{baseUrl}}/api/v1/users/admin/all?page=1&limit=20&role=academic_staff
Authorization: Bearer {{adminToken}}

###
GET {{baseUrl}}/api/v1/users/admin/all?page=1&limit=20&role=affairs_staff
Authorization: Bearer {{adminToken}}


###############################################################################
# 2. Get Single User Full Detail
###############################################################################
GET {{baseUrl}}/api/v1/users/admin/22010007
Authorization: Bearer {{adminToken}}

###
GET {{baseUrl}}/api/v1/users/admin/layla-hassan-1978-019
Authorization: Bearer {{adminToken}}


###############################################################################
# 3. Update User Fields
#    Allowed: first_name, second_name, third_name, fourth_name,
#             email, phone, address, birth, is_active
#    NOT allowed: password, role  (need separate flows for those)
#    Only send the fields you want to change — others stay untouched
###############################################################################

### update user's name and phone
PATCH {{baseUrl}}/api/v1/users/admin/22010007
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "first_name": "osamaa-updated",
    "phone": "01099887765"
}
###### update user photo
PATCH {{baseUrl}}/api/v1/users/admin/22010007
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "photo_url": "https://res.cloudinary.com/di1l2qchp/image/upload/test_photo.jpg",
    "publicId": "test_photo_public_id"
}
### deactivate a user
PATCH {{baseUrl}}/api/v1/users/admin/22010007
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "is_active": false
}

### reactivate a user
PATCH {{baseUrl}}/api/v1/users/admin/22010007
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "is_active": true
}

### update email
PATCH {{baseUrl}}/api/v1/users/admin/layla-hassan-1978-019
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "email": "laylaty.new@university.edu.eg"
}
