# global variables
@baseUrl = http://localhost:3000
@token =  PASTE_YOUR_JWT_TOKEN_HERE




Post {{baseUrl}}/api/v1/auth/login 
Content-Type: application/json

//osama student id in the database, 
# if you want to test with your CDS account search on DB for userId
{
    "userId": "layla-hassan-1978-019" ,
    "password":"12345678"
}

###
# super admin

Post {{baseUrl}}/api/v1/auth/login 
Content-Type: application/json

{
    "userId": "super-admin-1975-031" ,
    "password":"12345678"
}



### return the cloud signature,
Get {{baseUrl}}/api/v1/users/photo-signature?folderName=profile-photo
Authorization: Bearer {{token}}


### get user profile. 
GET {{baseUrl}}/api/v1/users/profile
Authorization: Bearer {{token}}


###  get User notifications. 
Get {{baseUrl}}/api/v1/users/notifications
Authorization: Bearer {{token}}

### update user's specific notification that he clicks on it to be read.
PATCH   {{baseUrl}}/api/v1/notifications/3/read
Authorization: Bearer {{token}}


### update user profile photo (after uploading to Cloudinary, save the URL)
PATCH {{baseUrl}}/api/v1/users/profile-photo
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "profilePhoto": "https://res.cloudinary.com/your-cloud/image/upload/v123/profile-photo/abc.jpg",
    "publicId": "profile-photo/abc"
}


### Delete a SPECIFIC notification by its ID
DELETE  {{baseUrl}}/api/v1/notifications/3/delete
Authorization: Bearer {{token}}


### Delete specific notification . 
DELETE  {{baseUrl}}/api/v1/notifications/delete 
Authorization: Bearer {{token}}


### delete all notifications
DELETE  {{baseUrl}}/api/v1/notifications/delete 
Authorization: Bearer {{token}}


