# ──────────────────────────────────────────────────────────────────────────
# UNIQ Database Package (Prisma) — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this same folder and fill in real values.
# Note: Prisma does not auto-load this file; it is loaded via
# `import "dotenv/config"` in prisma.config.ts (or by the Prisma CLI).
# Never commit your real `.env` file.
# ──────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres:change_me@postgres:5432/unv"
POSTGRES_USER=postgres
POSTGRES_PW=change_me
POSTGRES_DB=unv
APP_USER_PW=change_me
