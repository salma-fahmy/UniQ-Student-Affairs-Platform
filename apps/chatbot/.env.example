# ──────────────────────────────────────────────────────────────────────────
# UNIQ Chatbot Service — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this same folder and fill in real values.
# Never commit your real `.env` file.
# ──────────────────────────────────────────────────────────────────────────

# ── Groq LLM API key (https://console.groq.com) ─────────────────────────
GROQ_API_KEY=your_groq_api_key

# ── Base URL of the UNIQ API, used by the Streamlit demo UI (app.py) ───
BACKEND_URL=http://api:3000/api/v1

# ── Base URL of the UNIQ API, used by the FastAPI service (api/app.py) ─
AUTH_BACKEND_URL=http://api:3000

# ── Comma-separated list of allowed CORS origins for the FastAPI service
ALLOWED_ORIGINS=http://localhost:3000
