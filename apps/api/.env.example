# ──────────────────────────────────────────────────────────────────────────
# UNIQ API — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this same folder and fill in real values.
# Never commit your real `.env` file.
# ──────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV="development"
DEBUG=false

# ── Email (Nodemailer / Gmail App Password) ────────────────────────────
EMAIL=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Cloudinary (file/photo uploads) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Client / CORS ────────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"

# ── Database (app_user, RLS-restricted role used by the running API) ───
DATABASE_URL="postgresql://app_user:change_me@postgres:5432/unv"

# ── Redis (BullMQ / caching) ─────────────────────────────────────────────
REDIS_HOST="redis"
REDIS_PORT=6379

# ── JWT secrets — generate strong random values, e.g.:
#    openssl rand -hex 64
JWT_SECRET_SHORT_LIVE=replace_with_a_long_random_secret
JWT_SECRET_LONG_LIVE=replace_with_a_long_random_secret

# ── Postgres (used by entrypoint.sh to run migrations as superuser) ────
POSTGRES_USER=postgres
POSTGRES_PW=change_me
POSTGRES_DB=unv
APP_USER_PW=change_me

# ── Internal chatbot service URL ─────────────────────────────────────────
CHATBOT_URL=http://chatbot:7860

# ── Stripe (payments) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
