# ──────────────────────────────────────────────────────────────────────────
# UNIQ Email Worker — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this same folder and fill in real values.
# Never commit your real `.env` file.
# ──────────────────────────────────────────────────────────────────────────

# ── Email (Nodemailer / Gmail App Password) ────────────────────────────
EMAIL=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Cloudinary (only if referenced by shared config) ────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Client / CORS ────────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:change_me@postgres:5432/unv"

# ── Redis (BullMQ queue) ──────────────────────────────────────────────────
REDIS_HOST="redis"
REDIS_PORT=6379

# ── Support team notification address ────────────────────────────────────
SUPPORT_TEAM=support@example.com
