# ──────────────────────────────────────────────────────────────────────────
# UNIQ — Root Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# This root .env is consumed by docker-compose (via ${VAR} substitution)
# for the Postgres container and shared APP_USER_PW value.
# Never commit your real `.env` file.
# ──────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PW=change_me
POSTGRES_DB=unv

# ── Email (Nodemailer / Gmail App Password) ────────────────────────────
EMAIL=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Cloudinary (file/photo uploads) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Client / CORS ────────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"

# ── Database connection used by the API (app_user, RLS-restricted) ─────
DATABASE_URL="postgresql://app_user:change_me@postgres:5432/unv"

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST="redis"
REDIS_PORT=6379

# ── Restricted DB role password (granted at container startup) ─────────
APP_USER_PW=change_me

# ── Groq LLM API (used by the chatbot service) ──────────────────────────
GROQ_API_KEY=your_groq_api_key

# ── Hugging Face Hub token (used by the chatbot container, optional) ───
# Grants higher rate limits / faster model downloads. Leave empty to skip.
HF_TOKEN=your_huggingface_token
