# ──────────────────────────────────────────────────────────────────────────
# UNIQ Frontend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this same folder and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code.
# ──────────────────────────────────────────────────────────────────────────

# Base URL of the UNIQ API
VITE_API_BASE_URL=http://localhost:3000
